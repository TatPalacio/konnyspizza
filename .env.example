# Copia este archivo como .env (misma carpeta). .env no se sube a Git.
# Luego, desde esta carpeta: node scripts/build-config.js
# Eso reescribe js/config.js (URL y anon key) y js/admin-config.js (contraseña local del panel).
# Déjalos vacíos para seguir en modo demo. ADMIN_PASSWORD vacío usa konys2026.
# Esa contraseña solo abre el panel sin Supabase. No es un usuario de Authentication.
# index.html no carga admin-config.js.
# Nunca pongas la service_role key.

SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_PASSWORD=
