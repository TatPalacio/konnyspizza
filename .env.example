# Copia este archivo como .env (misma carpeta). .env no se sube a Git.
# Luego, desde esta carpeta: node scripts/build-config.js
# Eso reescribe js/config.js, que es lo que lee el navegador.
# Déjalos vacíos para seguir en modo demo. ADMIN_PASSWORD vacío usa konys2026.
# Esa contraseña se escribe solo en js/admin-config.js (la carga admin.html).
# js/config.js, que también carga la página pública, no la incluye.
# Cuando tu compañera pase las claves, pega solo la URL y la anon/public key.
# Nunca pongas la service_role key.

SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_PASSWORD=
